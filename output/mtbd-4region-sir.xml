<beast version="2.0"
       namespace="beast.base.inference:beast.base.inference.parameter:beast.base.evolution.tree:remaster">

<!-- GENERATED by R/02-xml.R : do not edit by hand.
     Regions: A, B, C, D   (0-indexed in reactions)
     Time unit: weeks. Seed region: D. -->

<run spec="Simulator" nSims="1">
  <simulate id="tree" spec="SimulatedTree">
    <trajectory id="traj" spec="StochasticTrajectory" maxTime="40"
                mustHave="case[0]>=20 &amp;&amp; case[1]>=20 &amp;&amp; case[2]>=3 &amp;&amp; case[3]>=20">

      <population       id="S"    spec="RealParameter" value="10000 20000 800 1499"/>
      <population       id="I"    spec="RealParameter" value="0 0 0 1"/>
      <samplePopulation id="case" spec="RealParameter" value="0 0 0 0"/>
      <samplePopulation id="seq"  spec="RealParameter" value="0 0 0 0"/>

      <!-- transmission: rate_i = R0_i * delta / N_i -->
      <reaction spec="Reaction" rate="0.00013"> S[0] + I[0] -> 2I[0] </reaction>
      <reaction spec="Reaction" rate="7.5e-05"> S[1] + I[1] -> 2I[1] </reaction>
      <reaction spec="Reaction" rate="0.0015"> S[2] + I[2] -> 2I[2] </reaction>
      <reaction spec="Reaction" rate="0.001066666667"> S[3] + I[3] -> 2I[3] </reaction>

      <!-- unobserved recovery -->
      <plate var="i" range="0:3">
        <reaction spec="Reaction" rate="0.6"> I[$(i)] -> 0 </reaction>
      </plate>

      <!-- detection with removal, split into sequenced / not sequenced -->
      <plate var="i" range="0:3">
        <reaction spec="Reaction" rate="0.32"> I[$(i)] -> case[$(i)] </reaction>
        <reaction spec="Reaction" rate="0.08">  I[$(i)] -> seq[$(i)]  </reaction>
      </plate>

      <!-- migration -->
      <reaction spec="Reaction" rate="0.05"> I[0] -> I[1] </reaction>   <!-- A -> B -->
      <reaction spec="Reaction" rate="0.002"> I[0] -> I[2] </reaction>   <!-- A -> C -->
      <reaction spec="Reaction" rate="0.002"> I[0] -> I[3] </reaction>   <!-- A -> D -->
      <reaction spec="Reaction" rate="0.04"> I[1] -> I[0] </reaction>   <!-- B -> A -->
      <reaction spec="Reaction" rate="0.002"> I[1] -> I[2] </reaction>   <!-- B -> C -->
      <reaction spec="Reaction" rate="0.002"> I[1] -> I[3] </reaction>   <!-- B -> D -->
      <reaction spec="Reaction" rate="0.008"> I[2] -> I[0] </reaction>   <!-- C -> A -->
      <reaction spec="Reaction" rate="0.002"> I[2] -> I[1] </reaction>   <!-- C -> B -->
      <reaction spec="Reaction" rate="0.002"> I[2] -> I[3] </reaction>   <!-- C -> D -->
      <reaction spec="Reaction" rate="0.02"> I[3] -> I[0] </reaction>   <!-- D -> A -->
      <reaction spec="Reaction" rate="0.02"> I[3] -> I[1] </reaction>   <!-- D -> B -->

    </trajectory>
  </simulate>

  <logger fileName="$(filebase).traj">
    <log idref="traj"/>
  </logger>

  <!-- tree pruned to SEQUENCED tips only; case-only tips are dropped -->
  <logger fileName="$(filebase).sampled.trees" mode="tree">
    <log spec="TypedTreeLogger">
      <tree spec="PrunedTree" samplePops="seq[0],seq[1],seq[2],seq[3]" simulatedTree="@tree"/>
    </log>
  </logger>
</run>
</beast>

